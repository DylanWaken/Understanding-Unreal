        "file": "Engine/Source/Runtime/Renderer/Private/Lumen/LumenScreenProbeImportanceSampling.cpp",
        "sha256": "f6bbfb893f9ed420a28b2657e88eaacf5c973fd3ffc08624b6f94867e4001b3f",
        "lines": [
          {
            "line": 246,
            "text": "\tbool UseImportanceSampling(const FViewInfo& View)"
          },
          {
            "line": 247,
            "text": "\t{"
          },
          {
            "line": 248,
            "text": "\t\tif (GLumenScreenProbeGatherReferenceMode)"
          },
          {
            "line": 249,
            "text": "\t\t{"
          },
          {
            "line": 250,
            "text": "\t\t\treturn false;"
          },
          {
            "line": 251,
            "text": "\t\t}"
          },
          {
            "line": 252,
            "text": ""
          },
          {
            "line": 253,
            "text": "\t\t// Shader permutations only created for these resolutions"
          },
          {
            "line": 254,
            "text": "\t\tconst int32 TracingResolution = GetTracingOctahedronResolution(View);"
          },
          {
