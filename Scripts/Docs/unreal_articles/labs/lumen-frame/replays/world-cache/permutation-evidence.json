          },
          {
            "line": 602,
            "text": "};"
          },
          {
            "line": 904,
            "text": "\t\tPermutationVector.Set< FScreenProbeTraceVoxelsCS::FThreadGroupSize32 >(Lumen::UseThreadGroupSize32());"
          },
          {
