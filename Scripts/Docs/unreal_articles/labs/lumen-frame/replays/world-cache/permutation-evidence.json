      {
        "label": "trace dispatch guard and cache call",
        "file": "Engine/Shaders/Private/Lumen/LumenScreenProbeTracing.usf",
        "sha256": "397de6574bd4a8d38413834953ea4b175fe24e25b1b4ca9414e826378497b49f",
        "lines": [
          {
            "line": 685,
            "text": "#if THREADGROUP_SIZE_32"
          },
          {
            "line": 686,
            "text": "\t#define PROBE_TRACE_THREADGROUP_SIZE_1D 32"
          },
          {
            "line": 687,
            "text": "#else"
          },
          {
            "line": 688,
            "text": "\t#define PROBE_TRACE_THREADGROUP_SIZE_1D 64"
          },
          {
            "line": 693,
            "text": "[numthreads(PROBE_TRACE_THREADGROUP_SIZE_1D, 1, 1)]"
          },
          {
            "line": 699,
            "text": "\tif (DispatchThreadId.x < CompactedTraceTexelAllocator[0])"
          },
          {
            "line": 700,
            "text": "\t{"
          },
          {
            "line": 701,
            "text": "\t\tuint ScreenProbeIndex;"
          },
          {
            "line": 702,
            "text": "\t\tuint2 TraceTexelCoord;"
          },
          {
            "line": 703,
            "text": "\t\tReadTraceTexel(DispatchThreadId.x, ScreenProbeIndex, TraceTexelCoord);"
          },
          {
            "line": 704,
            "text": ""
          },
          {
            "line": 719,
            "text": "\tuint2 ScreenProbeScreenPosition = GetScreenProbeScreenPosition(ScreenProbeIndex);"
          },
          {
            "line": 720,
            "text": "\tuint2 ScreenTileCoord = GetScreenTileCoord(ScreenProbeScreenPosition);"
          },
          {
            "line": 727,
            "text": "\t{"
          },
          {
            "line": 828,
            "text": "\t\t\t\tfloat TransparencyBeforeRadianceCache = TraceResult.Transparency;"
          },
          {
            "line": 829,
            "text": "\t\t\t\t// Extra AO, Skylight Leaking and fogging need hit distances further than what screen probes trace"
          },
          {
            "line": 830,
            "text": "\t\t\t\tfloat RadianceCacheHitDistance = TraceHitDistance;"
          },
          {
            "line": 831,
            "text": "\t\t\t\tSampleRadianceCacheAndApply(Coverage, TranslatedWorldPosition, RayWorldDirection, ConeHalfAngle, /*RandomScalarForStochasticIterpolation*/ 0.5f, TraceResult.Lighting, TraceResult.Transparency, RadianceCacheHitDistance);"
          },
          {
            "line": 832,
            "text": ""
          },
          {
            "line": 833,
            "text": "\t\t\t\tif (TransparencyBeforeRadianceCache > 0.0f)"
          },
          {
            "line": 859,
            "text": "\t\t\t\tRWTraceRadiance[TraceBufferCoord] = float3(0, 0, .5f) * View.PreExposure;"
          },
          {
            "line": 860,
            "text": "\t\t\t#else"
          },
          {
            "line": 861,
            "text": "\t\t\t\tRWTraceRadiance[TraceBufferCoord] = QuantizeForFloatRenderTarget(TraceResult.Lighting, int3(TraceBufferCoord, View.StateFrameIndexMod8));"
          },
          {
            "line": 862,
            "text": "\t\t\t#endif"
          },
          {
            "line": 870,
            "text": "\t\tWriteTraceHit(TraceBufferCoord, TraceHitDistanceForSpatialFiltering, bHit, false, /*bReachedRadianceCache*/ false);"
          },
          {
            "line": 874,
            "text": "[numthreads(PROBE_TRACE_THREADGROUP_SIZE_1D, 1, 1)]"
          },
          {
            "line": 875,
