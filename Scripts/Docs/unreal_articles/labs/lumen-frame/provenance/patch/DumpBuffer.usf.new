// Exact byte copy of a buffer into a linear uint staging texture.
//
// This is only used for the diagnostic readback of buffers flagged ERDGBufferFlags::SkipTracking, which RDG never
// transitions: the source buffer is read through a raw shader resource view in the state the owning pass already
// requires, and no value is interpreted or fabricated. Four source bytes are copied into one uint texel, so the
// staging texture rows concatenated in ascending (x, y) order reproduce the buffer bytes verbatim.

#include "../Common.ush"

#define TILE_SIZE 8

ByteAddressBuffer SourceBuffer;
RWTexture2D<uint> StagingOutput;

// Number of 32 bit elements in this chunk of the source buffer.
uint NumElements;

// Number of texels per staging row. Elements are laid out row major, so element index = y * WidthElements + x.
uint WidthElements;

// Byte offset of the requested view inside the raw SRV. Raw buffer views require a 16 byte aligned
// offset, so the exporter aligns the view down and uses this prefix to skip the bytes before the
// requested range. It is always a multiple of 4.
uint SourceByteOffset;

[numthreads(TILE_SIZE, TILE_SIZE, 1)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	// Explicit bounds guard: out of range lanes do not rely on API UAV write masking.
	uint StagingWidth = 0;
	uint StagingHeight = 0;
	StagingOutput.GetDimensions(StagingWidth, StagingHeight);

	if (DispatchThreadId.x >= StagingWidth || DispatchThreadId.y >= StagingHeight)
	{
		return;
	}

	uint ElementIndex = DispatchThreadId.y * WidthElements + DispatchThreadId.x;

	if (ElementIndex < NumElements)
	{
		StagingOutput[DispatchThreadId] = SourceBuffer.Load(SourceByteOffset + ElementIndex * 4);
	}
}
