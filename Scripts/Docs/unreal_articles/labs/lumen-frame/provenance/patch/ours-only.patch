 //------------------------------------------------------- ENTRY POINT
 
 [numthreads(TILE_SIZE, TILE_SIZE, 1)]
 void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
 {
+	// Explicit bounds guard: out of range lanes do not rely on API UAV write masking.
+	uint StagingWidth = 0;
+	uint StagingHeight = 0;
+	StagingOutput.GetDimensions(StagingWidth, StagingHeight);
+
+	if (DispatchThreadId.x >= StagingWidth || DispatchThreadId.y >= StagingHeight)
+	{
+		return;
+	}
+
+#if defined(TEXTURE_DIMENSION_3D)
+	// The SRV covers a single mip level, so the mip index of the load is always 0.
+	payload PixelValue = Texture.Load(int4(DispatchThreadId, int(ZSlice), 0));
+#elif defined(TEXTURE_DIMENSION_ARRAY)
+	payload PixelValue = Texture.Load(int4(DispatchThreadId, 0, 0));
+#else
 	payload PixelValue = Texture[DispatchThreadId];
+#endif
 	
 	#if defined(SWIZZLE_STENCIL)
 		PixelValue = payload(PixelValue STENCIL_COMPONENT_SWIZZLE, 0, 0, 0);
