+/**
+ * Exact byte copy of a buffer into a linear uint staging texture, used for the diagnostic readback of
+ * buffers flagged ERDGBufferFlags::SkipTracking. A raw (ByteAddressBuffer) view is used so that no pixel
+ * format interpretation is applied: four source bytes are copied into one uint texel, bit for bit.
+ */
+class FDumpBufferCS : public FGlobalShader
+{
+	DECLARE_GLOBAL_SHADER(FDumpBufferCS);
+	SHADER_USE_PARAMETER_STRUCT(FDumpBufferCS, FGlobalShader);
+
+	BEGIN_SHADER_PARAMETER_STRUCT(FParameters, )
+		SHADER_PARAMETER_SRV(ByteAddressBuffer, SourceBuffer)
+		SHADER_PARAMETER_UAV(RWTexture2D, StagingOutput)
+		SHADER_PARAMETER(uint32, NumElements)
+		SHADER_PARAMETER(uint32, WidthElements)
+		/** Byte prefix inside the 16 byte aligned raw SRV that precedes the requested view. */
+		SHADER_PARAMETER(uint32, SourceByteOffset)
+	END_SHADER_PARAMETER_STRUCT()
+};
+
+IMPLEMENT_GLOBAL_SHADER(FDumpBufferCS, "/Engine/Private/Tools/DumpBuffer.usf", "MainCS", SF_Compute);
+
 } // namespace
 
