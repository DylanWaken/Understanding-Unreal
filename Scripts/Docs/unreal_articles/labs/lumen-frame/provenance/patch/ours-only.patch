+	static void GetSubresourceValueInterpretation(
+		EPixelFormat NativeFormat,
+		EPixelFormat StagingFormat,
+		EPixelFormat StoredFormat,
+		bool bViewSRGB,
+		FString& OutInterpretation,
+		bool& bOutBitExact,
+		bool& bOutValuePreserving,
+		FString& OutCondition)
+	{
+		const bool bSameStagingFormat = (StagingFormat == NativeFormat);
+		const bool bSameStoredFormat = (StoredFormat == NativeFormat);
