+	/**
+	 * Returns the diagnostic wrapper for a native RHI texture. An existing renderer registration is reused unchanged and
+	 * keeps its real tracking state. A wrapper registered only for this diagnostic is memoized in the dump context and
+	 * its RHI lookup is removed by FRDGBuilder::DumpResourcePassOutputs right after the dump traversal, so a later
+	 * ordinary renderer registration of the same RHI texture gets its own normal wrapper. The wrapper object stays
+	 * alive because the scheduled dump passes reference it.
+	 */
+	FRDGTextureRef GetOrRegisterDiagnosticNativeTexture(FRDGBuilder& GraphBuilder, FRHITexture* Texture)
+	{
+		if (!Texture)
+		{
+			return nullptr;
+		}
+
+		if (FRDGTextureRef* Found = IsolatedNativeTextures.Find(Texture))
+		{
+			// If a real renderer registration appeared later in the same graph, use that actual tracked wrapper instead
+			// of the diagnostic wrapper so RDG transitions and versions stay the renderer's.
+			if (FRDGTextureRef CurrentTexture = GraphBuilder.FindExternalTexture(Texture))
+			{
+				if (CurrentTexture != *Found)
+				{
+					*Found = CurrentTexture;
+					return CurrentTexture;
+				}
+			}
+			return *Found;
+		}
+
+		// Never shadow or replace an existing renderer registration. This is the actual tracked RDG state, so RDG
+		// transitions and resource versions remain the renderer's.
+		if (FRDGTextureRef ExistingTexture = GraphBuilder.FindExternalTexture(Texture))
+		{
+			IsolatedNativeTextures.Add(Texture, ExistingTexture);
+			return ExistingTexture;
+		}
+
+		TRefCountPtr<IPooledRenderTarget> PooledTexture = CreateRenderTarget(Texture, TEXT("DumpGPU.NativeUniformBufferBinding"));
+		if (!PooledTexture)
+		{
+			return nullptr;
+		}
+
+		FRDGTextureRef RDGTexture = GraphBuilder.RegisterExternalTexture(
+			PooledTexture, TEXT("DumpGPU.NativeUniformBufferBinding"), ERDGTextureFlags::SkipTracking);
+		if (RDGTexture)
+		{
+			IsolatedNativeTextures.Add(Texture, RDGTexture);
+			// Mark it for removal from the builder's RHI lookup only. The graph-owned FRDGTexture itself is kept.
+			PendingIsolatedTextureLookupRemovals.Add(Texture);
+		}
+		return RDGTexture;
+	}
