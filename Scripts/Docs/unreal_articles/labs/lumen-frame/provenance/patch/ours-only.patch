+			? (NativeDesc.ArraySize * 6)
+			: NativeDesc.ArraySize;
+		if (OutSummary.FaceCount <= 0 || OutSummary.FaceFirst + OutSummary.FaceCount > MaxArraySlices)
+		{
+			OutSummary.SkipReason = TEXT("NativeViewArrayRangeOutOfBounds");
+			return false;
+		}
+
+		FRDGTextureSRVDesc ViewDesc = FRDGTextureSRVDesc::Create(RDGTexture);
+		ViewDesc.MipLevel = uint8(OutSummary.MipFirst);
+		ViewDesc.NumMipLevels = uint8(OutSummary.MipCount);
+		ViewDesc.Format = OutSummary.ViewFormat;
+		ViewDesc.SRGBOverride = OutSummary.bViewSRGB ? SRGBO_Default : SRGBO_ForceDisable;
+		// RHI validation requires FirstArraySlice == 0 and NumArraySlices == 0 for non-array textures (including 3D).
+		// Only array and cube resources carry a slice range in the SRV descriptor.
+		if (NativeDesc.IsTexture3D() || NativeDesc.Dimension == ETextureDimension::Texture2D)
+		{
+			ViewDesc.FirstArraySlice = 0;
+			ViewDesc.NumArraySlices = 0;
+		}
+		else
+		{
+			ViewDesc.FirstArraySlice = uint16(OutSummary.FaceFirst);
+			ViewDesc.NumArraySlices = uint16(OutSummary.FaceCount);
+		}
+
+		// Resolve the exact staging representation before scheduling. This keeps the binding-level status and the
+		// coverage inventory precise for unsupported depth/BC/format cases instead of a generic "not schedulable".
+		{
+			const int32 ProbeDepth = NativeDesc.IsTexture3D()
+				? FMath::Max(1, NativeDesc.Depth >> OutSummary.MipFirst)
+				: 1;
+			const FTextureSubresourceDumpDesc Probe = TranslateSubresourceDumpDesc(
+				NativeDesc,
+				OutSummary.ViewFormat,
+				OutSummary.bViewSRGB,
+				OutSummary.MipFirst,
+				ProbeDepth,
+				NativeDesc.IsTextureCube(),
+				/* bSkipTracking = */ false,
+				/* bForcePreprocess = */ false);
+			if (!Probe.IsDumpSupported())
+			{
+				OutSummary.SkipReason = Probe.UnsupportedReason
+					? Probe.UnsupportedReason
+					: TEXT("SkippedNativeTextureUnsupportedFormatOrDimension");
+				RecordSkippedTextureSubresource(ViewDesc, OutSummary.SkipReason);
+				return false;
+			}
+		}
+
+		OutSummary.BaseName = FString::Printf(TEXT("NativeTexture.%s.mip%d_%d.a%d_%d.f%d_%d.dim%d.plane%d"),
+			*PtrToString(NativeTexture), OutSummary.MipFirst, OutSummary.MipCount,
+			OutSummary.ArrayFirstInViewUnits, OutSummary.ArrayCountInViewUnits,
+			OutSummary.FaceFirst, OutSummary.FaceCount,
+			int32(ViewInfo.Dimension), int32(ViewInfo.Plane));
+		if (OutSummary.ViewFormat != NativeDesc.Format)
+		{
+			const TCHAR* FormatName = (OutSummary.ViewFormat < PF_MAX && GPixelFormats[OutSummary.ViewFormat].Name)
+				? GPixelFormats[OutSummary.ViewFormat].Name
+				: TEXT("Unknown");
+			OutSummary.BaseName += FString::Printf(TEXT(".fmt_%s"), FormatName);
+		}
+		if (OutSummary.bViewSRGB != EnumHasAnyFlags(NativeDesc.Flags, TexCreate_SRGB))
+		{
+			OutSummary.BaseName += OutSummary.bViewSRGB ? TEXT(".srgb") : TEXT(".linear");
+		}
+
+		if (!NativeTextureDescriptorsDumped.Contains(RDGTexture))
+		{
+			NativeTextureDescriptorsDumped.Add(RDGTexture);
+			if (!HasResourceEverBeenDumped(RDGTexture))
+			{
+				const FString UniqueResourceName = GetUniqueResourceName(RDGTexture);
+				TSharedPtr<FJsonObject> JsonObject = ToJson(UniqueResourceName, RDGTexture->Name, RDGTexture->Desc);
+				DumpJsonToFile(JsonObject, FString(FRDGResourceDumpContext::kBaseDir) / TEXT("ResourceDescs.json"), FILEWRITE_Append);
+			}
+		}
+
+		// The same exact view of the same native texture is read once per graph. A later consumer only registers its
+		// input edges and links to the already scheduled file; different mip/array/format/sRGB interpretations have a
+		// different BaseName and are never deduplicated together.
+		if (const FString* ExistingFile = ScheduledNativeTextureViewFiles.Find(OutSummary.BaseName))
+		{
+			AddDumpTextureAllSubResourcesPasses(
+				GraphBuilder,
+				InputResourceNames,
+				OutputResourceNames,
+				Pass,
+				ViewDesc,
+				/* bRegisterSubResourceToPass = */ true,
+				/* bIsOutputResource = */ false,
+				/* bAllowDumpBinary = */ false);
+
+			OutSummary.DumpFiles.Add(*ExistingFile);
+			OutSummary.bReusedExistingReadback = true;
+			if (const FRDGPass** FirstPass = ScheduledNativeTextureViewPasses.Find(OutSummary.BaseName))
+			{
+				OutSummary.FirstScheduledByPass = PtrToString(*FirstPass);
+			}
+			return true;
+		}
+
+		const int32 PassesBefore = ResourcesDumpPasses;
+		AddDumpTextureAllSubResourcesPasses(
+			GraphBuilder,
+			InputResourceNames,
+			OutputResourceNames,
+			Pass,
+			ViewDesc,
+			/* bRegisterSubResourceToPass = */ true,
+			/* bIsOutputResource = */ false,
+			/* bAllowDumpBinary = */ true,
+			/* VersionPassOverride = */ Pass,
+			/* OutDumpFilePaths = */ &OutSummary.DumpFiles);
+
+		OutSummary.ScheduledSubresources = ResourcesDumpPasses - PassesBefore;
+		if (OutSummary.ScheduledSubresources == 0)
+		{
+			// AddDumpTextureSubResourcePass wrote the exact per-subresource reason to ResourceDumpSkipped.json.
+			OutSummary.SkipReason = TEXT("NativeViewNotSchedulableSeeResourceDumpSkipped");
+			return false;
+		}
+
+		if (OutSummary.DumpFiles.Num() > 0)
+		{
+			ScheduledNativeTextureViewFiles.Add(OutSummary.BaseName, OutSummary.DumpFiles[0]);
+			ScheduledNativeTextureViewPasses.Add(OutSummary.BaseName, Pass);
+		}
+
+		return true;
+	}
+
+	/** Local mapping of a view dimension to text (FRHIViewDesc::GetTextureDimensionString is not exported). */
+	static const TCHAR* GetViewDimensionString(FRHIViewDesc::EDimension Dimension)	{
+		switch (Dimension)
+		{
+		case FRHIViewDesc::EDimension::Texture2D:			return TEXT("Texture2D");
+		case FRHIViewDesc::EDimension::Texture2DArray:		return TEXT("Texture2DArray");
+		case FRHIViewDesc::EDimension::Texture3D:			return TEXT("Texture3D");
+		case FRHIViewDesc::EDimension::TextureCube:			return TEXT("TextureCube");
+		case FRHIViewDesc::EDimension::TextureCubeArray:	return TEXT("TextureCubeArray");
+		default:											return TEXT("Unknown");
+		}
+	}
+
+	/** Local mapping of a buffer view type to text (FRHIViewDesc::GetBufferTypeString is not exported). */
+	static const TCHAR* GetBufferViewTypeString(FRHIViewDesc::EBufferType BufferType)
+	{
+		switch (BufferType)
+		{
+		case FRHIViewDesc::EBufferType::Typed:					return TEXT("Typed");
+		case FRHIViewDesc::EBufferType::Structured:				return TEXT("Structured");
+		case FRHIViewDesc::EBufferType::AccelerationStructure:	return TEXT("AccelerationStructure");
+		case FRHIViewDesc::EBufferType::Raw:					return TEXT("Raw");
+		default:												return TEXT("Unknown");
+		}
+	}
+
+	/**
+	 * Returns whether the dumped pass declares a writable access to the native buffer through an RDG buffer parameter.
+	 *
+	 * Native buffer bindings are collected after the pass executed. A pass that also writes the same RHI buffer would
+	 * make a post-execute read the output of the pass rather than its input, so those bindings are rejected instead of
+	 * being mislabelled as pass inputs.
+	 */
+	static bool IsNativeBufferWrittenByPass(const FRDGPass* Pass, FRHIBuffer* NativeBuffer)
+	{
+		if (!NativeBuffer)
+		{
+			return false;
+		}
+
+		bool bWritable = false;
+
+		Pass->GetParameters().Enumerate([&](FRDGParameter Parameter)
+		{
+			if (bWritable)
+			{
+				return;
+			}
+
+			switch (Parameter.GetType())
+			{
+			case UBMT_RDG_BUFFER_UAV:
+			{
+				if (FRDGBufferUAVRef UAV = Parameter.GetAsBufferUAV())
+				{
+					bWritable |= (UAV->Desc.Buffer->GetRHIUnchecked() == NativeBuffer);
+				}
+			}
+			break;
+			case UBMT_RDG_BUFFER_ACCESS:
+			{
+				if (FRDGBufferAccess BufferAccess = Parameter.GetAsBufferAccess())
+				{
+					bWritable |= (BufferAccess.GetBuffer()->GetRHIUnchecked() == NativeBuffer && IsWritableAccess(BufferAccess.GetAccess()));
+				}
+			}
+			break;
+			case UBMT_RDG_BUFFER_ACCESS_ARRAY:
+			{
+				for (FRDGBufferAccess BufferAccess : Parameter.GetAsBufferAccessArray())
+				{
+					if (BufferAccess.GetBuffer()->GetRHIUnchecked() == NativeBuffer && IsWritableAccess(BufferAccess.GetAccess()))
+					{
+						bWritable = true;
+						break;
+					}
+				}
+			}
+			break;
+			default:
+				break;
+			}
+		});
+
+		return bWritable;
+	}	/** Base types that store a native (non render graph) resource pointer in a uniform buffer. */
+	static bool IsNativeResourceBaseType(EUniformBufferBaseType BaseType)
+	{
+		switch (BaseType)
+		{
+		case UBMT_TEXTURE:
+		case UBMT_SRV:
+		case UBMT_UAV:
+		case UBMT_SAMPLER:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	/** Maps the absolute byte offset of each native resource member of a shader parameter struct to its member path. */
+	static void CollectNativeBindingMemberNames(
+		const FShaderParametersMetadata* Metadata,
+		uint32 BaseOffset,
+		const FString& Prefix,
+		TMap<uint32, FString>& OutNames,
+		TMap<uint32, uint32>& OutElementCounts,
+		TMap<uint32, uint32>& OutMemberBaseOffsets)
+	{
+		for (const FShaderParametersMetadata::FMember& Member : Metadata->GetMembers())
+		{
+			const uint32 Offset = BaseOffset + Member.GetOffset();
+			const EUniformBufferBaseType BaseType = Member.GetBaseType();
+
+			// Inline structs hold their native resource members inline, so recurse. An array of inline structs is a C
+			// array of the concrete struct type, so its element stride is the metadata struct size. Referenced structs
+			// and RDG uniform buffers have their own storage and are not part of this uniform buffer's payload.
+			if (Member.GetStructMetadata()
+				&& BaseType != UBMT_REFERENCED_STRUCT
+				&& BaseType != UBMT_RDG_UNIFORM_BUFFER)
+			{
+				const uint32 StructElementCount = FMath::Max(1u, Member.GetNumElements());
+				const uint32 StructStride = Member.GetStructMetadata()->GetSize();
+				if (StructStride == 0)
+				{
+					continue;
+				}
+
+				for (uint32 ElementIndex = 0; ElementIndex < StructElementCount; ElementIndex++)
+				{
+					const FString ElementPrefix = (StructElementCount > 1)
+						? FString::Printf(TEXT("%s%s[%u]."), *Prefix, Member.GetName(), ElementIndex)
+						: FString::Printf(TEXT("%s%s."), *Prefix, Member.GetName());
+
+					CollectNativeBindingMemberNames(
+						Member.GetStructMetadata(),
+						Offset + ElementIndex * StructStride,
+						ElementPrefix,
+						OutNames,
+						OutElementCounts,
+						OutMemberBaseOffsets);
+				}
+				continue;
+			}
+
+			if (!IsNativeResourceBaseType(BaseType))
+			{
+				continue;
+			}
+
+			// The RHI uniform buffer layout carries one resource entry per array element (see
+			// ShaderParameterMetadata.cpp), each with its own exact MemberOffset. Mirror that here so every element gets
+			// its own path and there is no second, guessed expansion on top of the layout's element enumeration.
+			const uint32 ArrayElementCount = FMath::Max(1u, Member.GetNumElements());
+			for (uint32 ElementIndex = 0; ElementIndex < ArrayElementCount; ElementIndex++)
+			{
+				const uint32 ElementOffset = Offset + ElementIndex * SHADER_PARAMETER_POINTER_ALIGNMENT;
+				const FString ElementName = (ArrayElementCount > 1)
+					? FString::Printf(TEXT("%s[%u]"), Member.GetName(), ElementIndex)
+					: FString(Member.GetName());
+
+				OutNames.Add(ElementOffset, Prefix + ElementName);
+				OutElementCounts.Add(ElementOffset, ArrayElementCount);
+				OutMemberBaseOffsets.Add(ElementOffset, Offset);
+			}
+		}
+	}
+
+	/**
+	 * Exports the native RHI resource bindings of a referenced uniform buffer (the resources a shader reads through
+	 * the uniform buffer rather than through a render graph pass parameter: GDF atlases, LTC LUTs, preintegrated BRDF,
+	 * BlueNoise LUTs, ...).
+	 *
+	 * The uniform buffer content is the CPU copy maintained by r.RHI.UniformBufferContentMap, so each member offset
+	 * yields the exact pointer the shader will read. Textures bound as TEXTURE/SRV members are exported through the
+	 * existing subresource pipeline (all mips, slices and z slices) by registering the native texture as an external
+	 * render graph texture flagged SkipTracking: RDG then never transitions it and the read is the same compute shader
+	 * SRV read the owning pass already relies on. UAV and sampler members are recorded with their pointer and type but
+	 * no access state is inferred and no bytes are fabricated.
+	 */
+	void DumpNativeUniformBufferBindings(
+		FRDGBuilder& GraphBuilder,
+		const FRDGPass* Pass,
+		TArray<TSharedPtr<FJsonValue>>& InputResourceNames,
+		TArray<TSharedPtr<FJsonValue>>& OutputResourceNames,
+		const FRHIUniformBuffer* UniformBuffer,
+		const uint8* UniformBufferContent,
+		const FShaderParametersMetadata* Metadata,
+		const FString& Prefix)
+	{
+		const FRHIUniformBufferLayout& Layout = UniformBuffer->GetLayout();
+		if (Layout.Resources.Num() == 0 || !UniformBufferContent || !Metadata)
+		{
+			return;
+		}
+
+		TMap<uint32, FString> MemberNames;
+		TMap<uint32, uint32> MemberElementCounts;
+		TMap<uint32, uint32> MemberBaseOffsets;
+		CollectNativeBindingMemberNames(Metadata, 0, Prefix, MemberNames, MemberElementCounts, MemberBaseOffsets);
+
+		// Native resource arrays in a uniform buffer are C arrays of the concrete pointer type (see
+		// ShaderParameterMacros.h), so the element stride is the shader parameter pointer alignment (8 on every
+		// platform, to match the largest pointer) and not a uniform array stride. The RHI layout already contains one
+		// entry per element; every read is bounded by the constant buffer size.
+		const uint32 ElementStride = SHADER_PARAMETER_POINTER_ALIGNMENT;
+
+		// A native buffer SRV is read after its owning pass executed. If the same uniform buffer also binds the buffer
+		// through a UAV, the SRV is not necessarily the pass input; collect those aliases so they are rejected instead
+		// of being labelled as an input.
+		TSet<FRHIBuffer*> WritableNativeBuffers;
+		TSet<FRHITexture*> WritableNativeTextures;
+		for (const FRHIUniformBufferResource& WritableResource : Layout.Resources)
+		{
+			if (WritableResource.MemberType != UBMT_UAV || WritableResource.MemberOffset >= Layout.ConstantBufferSize
+				|| (uint32(WritableResource.MemberOffset) + ElementStride) > Layout.ConstantBufferSize)
+			{
+				continue;
+			}
+
+			FRHIView* WritableView = *reinterpret_cast<FRHIView* const*>(UniformBufferContent + WritableResource.MemberOffset);
+			if (WritableView && WritableView->IsBuffer())
+			{
+				WritableNativeBuffers.Add(WritableView->GetBuffer());
+			}
+			else if (WritableView && WritableView->IsTexture())
+			{
+				WritableNativeTextures.Add(WritableView->GetTexture());
+			}
+		}
+
+		TSharedPtr<FJsonObject> BindingsJson = MakeShareable(new FJsonObject);
+
+		for (const FRHIUniformBufferResource& Resource : Layout.Resources)
+		{
+			if (!IsNativeResourceBaseType(Resource.MemberType))
+			{
+				continue;
+			}
+
+			if (Resource.MemberOffset >= Layout.ConstantBufferSize
+				|| (uint32(Resource.MemberOffset) + ElementStride) > Layout.ConstantBufferSize)
+			{
+				continue;
+			}
+
+			const FString* FoundName = MemberNames.Find(Resource.MemberOffset);
+			const FString MemberName = FoundName ? *FoundName : FString::Printf(TEXT("%soffset%u"), *Prefix, Resource.MemberOffset);
+
+			const uint32* FoundCount = MemberElementCounts.Find(Resource.MemberOffset);
+			const uint32 ArrayNumElements = FoundCount ? FMath::Max(1u, *FoundCount) : 1u;
+			const uint32* FoundBaseOffset = MemberBaseOffsets.Find(Resource.MemberOffset);
+			const uint32 MemberBaseOffset = FoundBaseOffset ? *FoundBaseOffset : Resource.MemberOffset;
+			const uint32 ElementOffset = Resource.MemberOffset;
+			const uint8* MemberContent = UniformBufferContent + ElementOffset;
+			const FString ElementName = MemberName;
+
+			TSharedPtr<FJsonObject> Entry = MakeShareable(new FJsonObject);
+			Entry->SetStringField(TEXT("BaseType"), GetUniformBufferBaseTypeString(Resource.MemberType));
+			Entry->SetNumberField(TEXT("MemberBaseOffset"), MemberBaseOffset);
+			Entry->SetNumberField(TEXT("MemberOffset"), ElementOffset);
+			Entry->SetNumberField(TEXT("ElementStrideBytes"), ElementStride);
+			Entry->SetNumberField(TEXT("ArrayNumElements"), ArrayNumElements);
+			// The pointer is captured from the uniform buffer payload; the resource access state is not part of it.
+			Entry->SetBoolField(TEXT("StateCaptured"), false);
+			Entry->SetStringField(TEXT("Source"), TEXT("ReferencedUniformBufferContentMap"));
+
+			FRHITexture* Texture = nullptr;
+			// Exact SRV view of the native texture. For UBMT_SRV this is the view the shader samples; for a plain
+			// UBMT_TEXTURE slot the shader reads the whole resource, so a whole-resource view is synthesized below.
+			FRHIViewDesc::FTextureSRV::FViewInfo TextureViewInfo = {};
+			bool bHasTextureViewInfo = false;
+			bool bBufferView = false;
+			bool bNullView = false;
+
+			switch (Resource.MemberType)
+			{
+			case UBMT_TEXTURE:
+			{
+				Texture = *reinterpret_cast<FRHITexture* const*>(MemberContent);
+				Entry->SetStringField(TEXT("ResourceKind"), TEXT("Texture"));
+				Entry->SetStringField(TEXT("Pointer"), PtrToString(Texture));
+				Entry->SetBoolField(TEXT("Null"), Texture == nullptr);
+			}
+			break;
+
+			case UBMT_SRV:
+			case UBMT_UAV:
+			{
+				FRHIView* View = *reinterpret_cast<FRHIView* const*>(MemberContent);
+				Entry->SetStringField(TEXT("ResourceKind"), Resource.MemberType == UBMT_SRV ? TEXT("ShaderResourceView") : TEXT("UnorderedAccessView"));
+				Entry->SetStringField(TEXT("Pointer"), PtrToString(View));
+				Entry->SetBoolField(TEXT("Null"), View == nullptr);
+				bNullView = (View == nullptr);
+				bBufferView = View && View->IsBuffer();
+
+				if (View && View->IsTexture())
+				{
+					Texture = View->GetTexture();
+					Entry->SetStringField(TEXT("UnderlyingTexture"), PtrToString(Texture));
+
+					// Preserve the exact view range and format the shader reads through, not only the resource.
+					if (Resource.MemberType == UBMT_SRV)
+					{
+						TextureViewInfo = View->GetDesc().Texture.SRV.GetViewInfo(Texture);
+						bHasTextureViewInfo = true;
+						const FRHIViewDesc::FTextureSRV::FViewInfo& ViewInfo = TextureViewInfo;
+						Entry->SetNumberField(TEXT("ViewMipFirst"), ViewInfo.MipRange.First);
+						Entry->SetNumberField(TEXT("ViewMipCount"), ViewInfo.MipRange.Num);
+						Entry->SetNumberField(TEXT("ViewArrayFirst"), ViewInfo.ArrayRange.First);
+						Entry->SetNumberField(TEXT("ViewArrayCount"), ViewInfo.ArrayRange.Num);
+						Entry->SetStringField(TEXT("ViewFormat"), ToJson(ViewInfo.Format));
+						Entry->SetBoolField(TEXT("ViewSRGB"), ViewInfo.bSRGB != 0);
+						Entry->SetStringField(TEXT("ViewDimension"), GetViewDimensionString(ViewInfo.Dimension));
+					}
+					else
+					{
+						const FRHIViewDesc::FTextureUAV::FViewInfo ViewInfo = View->GetDesc().Texture.UAV.GetViewInfo(Texture);
+						Entry->SetNumberField(TEXT("ViewMipFirst"), ViewInfo.MipLevel);
+						Entry->SetNumberField(TEXT("ViewMipCount"), 1);
+						Entry->SetNumberField(TEXT("ViewArrayFirst"), ViewInfo.ArrayRange.First);
+						Entry->SetNumberField(TEXT("ViewArrayCount"), ViewInfo.ArrayRange.Num);
+						Entry->SetStringField(TEXT("ViewFormat"), ToJson(ViewInfo.Format));
+						Entry->SetStringField(TEXT("ViewDimension"), GetViewDimensionString(ViewInfo.Dimension));
+					}
+				}
+				else if (View && View->IsBuffer())
+				{
+					FRHIBuffer* NativeBuffer = View->GetBuffer();
+					const FRHIBufferDesc& NativeBufferDesc = NativeBuffer->GetDesc();
+					Entry->SetStringField(TEXT("ResourceKind"), Resource.MemberType == UBMT_SRV ? TEXT("BufferShaderResourceView") : TEXT("BufferUnorderedAccessView"));
+					Entry->SetStringField(TEXT("UnderlyingBuffer"), PtrToString(NativeBuffer));
+					Entry->SetStringField(TEXT("UnderlyingBufferName"), *NativeBuffer->GetName().ToString());
+					Entry->SetNumberField(TEXT("NativeBufferByteSize"), NativeBufferDesc.Size);
+
+					if (Resource.MemberType == UBMT_SRV)
+					{
+						const FRHIViewDesc::FBufferSRV::FViewInfo BufferViewInfo = View->GetDesc().Buffer.SRV.GetViewInfo(NativeBuffer);
+						Entry->SetStringField(TEXT("BufferViewType"), GetBufferViewTypeString(BufferViewInfo.BufferType));
+						if (BufferViewInfo.BufferType != FRHIViewDesc::EBufferType::AccelerationStructure)
+						{
+							Entry->SetNumberField(TEXT("ViewOffsetInBytes"), BufferViewInfo.OffsetInBytes);
+							Entry->SetNumberField(TEXT("ViewSizeInBytes"), BufferViewInfo.SizeInBytes);
+							Entry->SetNumberField(TEXT("ViewStrideInBytes"), BufferViewInfo.StrideInBytes);
+							Entry->SetNumberField(TEXT("ViewNumElements"), BufferViewInfo.NumElements);
+							Entry->SetStringField(TEXT("ViewFormat"), ToJson(BufferViewInfo.Format));
+							Entry->SetBoolField(TEXT("ViewIsNull"), BufferViewInfo.bNullView);
+							Entry->SetBoolField(TEXT("ExactViewByteRange"), true);
+							if (BufferViewInfo.BufferType == FRHIViewDesc::EBufferType::Typed)
+							{
+								const bool bFormatHasEntry = BufferViewInfo.Format != PF_Unknown && BufferViewInfo.Format < PF_MAX;
+								Entry->SetNumberField(TEXT("ViewFormatBlockBytes"), bFormatHasEntry ? GPixelFormats[BufferViewInfo.Format].BlockBytes : 0);
+								Entry->SetBoolField(TEXT("ViewStrideMatchesFormat"),
+									bFormatHasEntry && GPixelFormats[BufferViewInfo.Format].BlockBytes == BufferViewInfo.StrideInBytes);
+							}
+						}
+
+						const bool bHasByteAddressBufferUsage = EnumHasAnyFlags(NativeBuffer->GetUsage(), BUF_ByteAddressBuffer);
+						Entry->SetBoolField(TEXT("RawViewSupportedForAnyBuffer"), GRHISupportsRawViewsForAnyBuffer);
+						Entry->SetBoolField(TEXT("BufferHasByteAddressBufferUsage"), bHasByteAddressBufferUsage);
+						Entry->SetStringField(TEXT("RawViewSupportBasis"),
+							GRHISupportsRawViewsForAnyBuffer ? TEXT("GRHISupportsRawViewsForAnyBuffer") :
+							bHasByteAddressBufferUsage ? TEXT("ByteAddressBufferUsage") : TEXT("None"));
+						Entry->SetBoolField(TEXT("ForcedRawViewOnStructuredBuffer"),
+							BufferViewInfo.BufferType == FRHIViewDesc::EBufferType::Structured && !bHasByteAddressBufferUsage);
+
+						const int32 BufferDumpMode = GDumpBufferCVar.GetValueOnRenderThread();
+						if (BufferViewInfo.bNullView || NativeBufferDesc.IsNull())
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNullNativeBufferView"));
+						}
+						else if (BufferViewInfo.BufferType == FRHIViewDesc::EBufferType::AccelerationStructure)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeAccelerationStructureView"));
+						}
+						else if (BufferViewInfo.BufferType == FRHIViewDesc::EBufferType::Unknown)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferViewTypeUnknown"));
+						}
+						else if (BufferViewInfo.SizeInBytes == 0)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedEmptyNativeBufferView"));
+						}
+						else if ((BufferViewInfo.OffsetInBytes % 4) != 0 || (BufferViewInfo.SizeInBytes % 4) != 0)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferViewNotDwordAligned"));
+						}
+						else if (!EnumHasAnyFlags(NativeBuffer->GetUsage(), EBufferUsageFlags::ShaderResource)
+							&& !EnumHasAnyFlags(NativeBuffer->GetUsage(), EBufferUsageFlags::ByteAddressBuffer)
+							&& !EnumHasAnyFlags(NativeBuffer->GetUsage(), EBufferUsageFlags::StructuredBuffer))
+						{
+							// ByteAddressBuffer/StructuredBuffer are shader-readable by construction; ShaderResource is
+							// only needed for buffer types that would not otherwise be bindable as an SRV.
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferWithoutShaderResourceUsage"));
+						}
+						else if (!GRHISupportsRawViewsForAnyBuffer && !bHasByteAddressBufferUsage)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferRawViewUnsupported"));
+						}
+						else if (WritableNativeBuffers.Contains(NativeBuffer) || IsNativeBufferWrittenByPass(Pass, NativeBuffer))
+						{
+							// Collecting after pass execution would expose the pass output, not the input the shader read.
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferAliasedByWritablePassBinding"));
+							Entry->SetStringField(TEXT("TimingBlocker"), TEXT("PostExecuteReadWouldNotBePassInput"));
+						}
+						else if (BufferDumpMode == 0)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedBufferDumpDisabledByCVar"));
+						}
+						else if (BufferDumpMode == 1)
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedBufferDumpDescriptorsOnlyByCVar"));
+						}
+						else if (IsUnsafeToDumpResource(BufferViewInfo.SizeInBytes, 1.2f))
+						{
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeBufferStagingMemoryBudget"));
+						}
+						else
+						{
+							const FString UniqueResourceName = FString::Printf(TEXT("NativeBuffer.%s.o%u.n%u"),
+								*PtrToString(NativeBuffer), BufferViewInfo.OffsetInBytes, BufferViewInfo.NumElements);
+							const FString DumpFilePath = kResourcesDir / FString::Printf(TEXT("%s.v%s.bin"), *UniqueResourceName, *PtrToString(Pass));
+
+							// The owning pass binds this exact view as an SRV, so the buffer is already in a readable state.
+							// The read is a raw SRV over the exact view byte range and writes only to a private staging
+							// texture: no transition, copy or restore of the native buffer is issued.
+							AddDumpNativeBufferViewPass(GraphBuilder, Pass, NativeBuffer, BufferViewInfo.OffsetInBytes, BufferViewInfo.SizeInBytes, DumpFilePath);
+							InputResourceNames.AddUnique(MakeShareable(new FJsonValueString(UniqueResourceName)));
+
+							Entry->SetStringField(TEXT("DumpedAs"), UniqueResourceName);
+							Entry->SetStringField(TEXT("DumpFile"), DumpFilePath);
+							Entry->SetNumberField(TEXT("ExportByteSize"), BufferViewInfo.SizeInBytes);
+							Entry->SetStringField(TEXT("ExportFidelity"), TEXT("ExactBytesThroughRawSRV"));
+							Entry->SetStringField(TEXT("ReadStateBasis"), TEXT("ReadOnlyUniformBufferSRVBinding"));
+							Entry->SetBoolField(TEXT("TransitionIssued"), false);
+							Entry->SetBoolField(TEXT("OwnerPassExecutionDependencyClaimed"), false);
+							Entry->SetBoolField(TEXT("SourceStateProvenAtScheduling"), FRDGBuilder::IsImmediateMode());
+							Entry->SetStringField(TEXT("TimingRisk"), FRDGBuilder::IsImmediateMode()
+								? TEXT("None")
+								: TEXT("OwnerPassNotExecutedAtCPUCollection;NativeResourceHasNoRDGExecutionDependency"));
+							Entry->SetBoolField(TEXT("CrossUniformBufferAliasObservable"), false);
+							Entry->SetStringField(TEXT("RawViewOffsetPolicy"), TEXT("AlignDown16WithShaderPrefix"));
+							Entry->SetNumberField(TEXT("RawViewAlignedBaseOffset"), BufferViewInfo.OffsetInBytes & ~15u);
+							Entry->SetNumberField(TEXT("RawViewPrefixBytes"), BufferViewInfo.OffsetInBytes & 15u);
+							Entry->SetBoolField(TEXT("FileVerified"), false);
+							Entry->SetStringField(TEXT("ReadbackStatusFile"), TEXT("Base/DumpReadbackStatus.json"));
+							Entry->SetStringField(TEXT("DumpStatus"), TEXT("ScheduledForReadback"));
+						}
+					}
+					else
+					{
+						const FRHIViewDesc::FBufferUAV::FViewInfo BufferViewInfo = View->GetDesc().Buffer.UAV.GetViewInfo(NativeBuffer);
+						Entry->SetStringField(TEXT("BufferViewType"), GetBufferViewTypeString(BufferViewInfo.BufferType));
+						Entry->SetNumberField(TEXT("ViewOffsetInBytes"), BufferViewInfo.OffsetInBytes);
+						Entry->SetNumberField(TEXT("ViewSizeInBytes"), BufferViewInfo.SizeInBytes);
+						Entry->SetNumberField(TEXT("ViewStrideInBytes"), BufferViewInfo.StrideInBytes);
+						Entry->SetNumberField(TEXT("ViewNumElements"), BufferViewInfo.NumElements);
+						Entry->SetStringField(TEXT("ViewFormat"), ToJson(BufferViewInfo.Format));
+						Entry->SetBoolField(TEXT("ViewIsNull"), BufferViewInfo.bNullView);
+						Entry->SetBoolField(TEXT("ViewAtomicCounter"), BufferViewInfo.bAtomicCounter);
+						Entry->SetBoolField(TEXT("ViewAppendBuffer"), BufferViewInfo.bAppendBuffer);
+						// A UAV member is written by the shader. The owner's UAV state cannot be observed or restored, so
+						// no bytes are read and no value is fabricated. The possible recovery follows the same rules as
+						// the SkipTracking blocker: only a read-only view plus an explicit UAV barrier could be legal,
+						// and the typed case additionally needs a typed load path.
+						Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeUAVBindingStateNotObservable"));
+						Entry->SetStringField(TEXT("RecoveryPath"),
+							BufferViewInfo.BufferType == FRHIViewDesc::EBufferType::Typed
+								? TEXT("TypedUAVReadPathNotImplemented")
+								: TEXT("ReadOnlyRawViewWithUAVBarrierNotValidated"));
+					}
+				}
+			}
+			break;
+
+			case UBMT_SAMPLER:
+			{
+				const void* Sampler = *reinterpret_cast<const void* const*>(MemberContent);
+				Entry->SetStringField(TEXT("ResourceKind"), TEXT("Sampler"));
+				Entry->SetStringField(TEXT("Pointer"), PtrToString(Sampler));
+				Entry->SetBoolField(TEXT("Null"), Sampler == nullptr);
+				// Static sampler initialisers are source resolved; only the bound slot is recorded here.
+				Entry->SetBoolField(TEXT("StaticInitializerCaptured"), false);
+			}
+			break;
+
+			default:
+				continue;
+			}
+
+			if (Texture)
+			{
+				const FRHITextureDesc& TextureDesc = Texture->GetDesc();
+				Entry->SetStringField(TEXT("NativeTextureName"), *Texture->GetName().ToString());
+				Entry->SetStringField(TEXT("NativeDimension"), GetTextureDimensionString(TextureDesc.Dimension));
+				Entry->SetStringField(TEXT("NativeFormat"), ToJson(TextureDesc.Format));
+				Entry->SetNumberField(TEXT("NativeExtentX"), TextureDesc.Extent.X);
+				Entry->SetNumberField(TEXT("NativeExtentY"), TextureDesc.Extent.Y);
+				Entry->SetNumberField(TEXT("NativeDepth"), TextureDesc.Depth);
+				Entry->SetNumberField(TEXT("NativeArraySize"), TextureDesc.ArraySize);
+				Entry->SetNumberField(TEXT("NativeNumMips"), TextureDesc.NumMips);
+
+				if (Resource.MemberType == UBMT_UAV)
+				{
+					// A UAV member is written by the shader; its state is a UAV state this readback cannot observe or
+					// restore, so it is recorded but never read.
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeUAVBindingStateNotObservable"));
+				}
+				else if (!EnumHasAnyFlags(TextureDesc.Flags, TexCreate_ShaderResource))
+				{
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedMissingShaderResourceFlag"));
+				}
+				else if (TextureDesc.NumSamples != 1)
+				{
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("NativeMultisampleTextureNotSupported"));
+				}
+				else if (EnumHasAnyFlags(TextureDesc.Flags, TexCreate_Memoryless))
+				{
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("MemorylessTexture"));
+				}
+				else if (WritableNativeTextures.Contains(Texture))
+				{
+					// The same uniform buffer writes this texture through a UAV in the same pass. The post-execute
+					// read would see the pass output, not the SRV input.
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeTextureAliasedByWritablePassBinding"));
+					Entry->SetStringField(TEXT("TimingBlocker"), TEXT("PostExecuteReadWouldNotBePassInput"));
+				}
+				else if (GDumpGPUNativeUniformBufferTexturesCVar.GetValueOnRenderThread() == 0)
+				{
+					Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedNativeTextureDumpDisabledByCVar"));
+					Entry->SetStringField(TEXT("ExportScope"), TEXT("ViewMetadataOnly"));
+					Entry->SetBoolField(TEXT("RegistryMutation"), false);
+					Entry->SetStringField(TEXT("EnableWith"), TEXT("r.DumpGPU.NativeUniformBufferTextures=1"));
+				}
+				else
+				{
+					const bool bWholeTexture = (Resource.MemberType == UBMT_TEXTURE);
+					if (bWholeTexture)
+					{
+						// A plain TEXTURE slot has no SRV view descriptor: the shader sees the whole resource in its
+						// native format and native sRGB interpretation. This is a real whole-resource view, not a
+						// widened fallback for a narrow SRV.
+						TextureViewInfo = {};
+						TextureViewInfo.MipRange.First = 0;
+						TextureViewInfo.MipRange.Num = TextureDesc.NumMips;
+						TextureViewInfo.ArrayRange.First = 0;
+						TextureViewInfo.ArrayRange.Num = TextureDesc.ArraySize;
+						TextureViewInfo.Format = TextureDesc.Format;
+						TextureViewInfo.bSRGB = EnumHasAnyFlags(TextureDesc.Flags, TexCreate_SRGB) ? 1 : 0;
+						TextureViewInfo.Plane = ERHITexturePlane::Primary;
+						switch (TextureDesc.Dimension)
+						{
+						case ETextureDimension::Texture2D:			TextureViewInfo.Dimension = FRHIViewDesc::EDimension::Texture2D; break;
+						case ETextureDimension::Texture2DArray:		TextureViewInfo.Dimension = FRHIViewDesc::EDimension::Texture2DArray; break;
+						case ETextureDimension::Texture3D:			TextureViewInfo.Dimension = FRHIViewDesc::EDimension::Texture3D; break;
+						case ETextureDimension::TextureCube:		TextureViewInfo.Dimension = FRHIViewDesc::EDimension::TextureCube; break;
+						case ETextureDimension::TextureCubeArray:	TextureViewInfo.Dimension = FRHIViewDesc::EDimension::TextureCubeArray; break;
+						default:									TextureViewInfo.Dimension = FRHIViewDesc::EDimension::Texture2D; break;
+						}
+						bHasTextureViewInfo = true;
+					}
+
+					FRDGTextureRef RDGTexture = bHasTextureViewInfo
+						? GetOrRegisterDiagnosticNativeTexture(GraphBuilder, Texture)
+						: nullptr;
+
+					if (RDGTexture)
+					{
+						FNativeTextureExportSummary Summary;
+						if (AddDumpNativeTextureViewPasses(
+							GraphBuilder,
+							InputResourceNames,
+							OutputResourceNames,
+							Pass,
+							RDGTexture,
+							Texture,
+							TextureDesc,
+							TextureViewInfo,
+							bWholeTexture,
+							Summary))
+						{
+							Entry->SetStringField(TEXT("DumpedAs"), Summary.BaseName);
+							Entry->SetStringField(TEXT("DiagnosticResource"), GetUniqueResourceName(RDGTexture));
+							Entry->SetStringField(TEXT("NativePointer"), PtrToString(Texture));
+							Entry->SetStringField(TEXT("NativeBindingPath"), ElementName);
+							Entry->SetNumberField(TEXT("ExportSubresourceCount"), Summary.ScheduledSubresources);
+							Entry->SetStringField(TEXT("ExportFirstFile"), Summary.DumpFiles.Num() > 0 ? Summary.DumpFiles[0] : FString());
+							Entry->SetBoolField(TEXT("ExportSRGB"), Summary.bViewSRGB);
+							Entry->SetBoolField(TEXT("ExportUsesWholeNativeResource"), bWholeTexture);
+							Entry->SetStringField(TEXT("ExportScope"), bWholeTexture ? TEXT("WholeNativeResource") : TEXT("ExactSRVView"));
+							Entry->SetStringField(TEXT("ExportRisk"), bWholeTexture ? TEXT("BindIsWholeTexture") : TEXT("None"));
+							Entry->SetNumberField(TEXT("ExportMipFirst"), Summary.MipFirst);
+							Entry->SetNumberField(TEXT("ExportMipCount"), Summary.MipCount);
+							Entry->SetNumberField(TEXT("ExportArrayFirstInViewUnits"), Summary.ArrayFirstInViewUnits);
+							Entry->SetNumberField(TEXT("ExportArrayCountInViewUnits"), Summary.ArrayCountInViewUnits);
+							Entry->SetNumberField(TEXT("ExportFaceFirst"), Summary.FaceFirst);
+							Entry->SetNumberField(TEXT("ExportFaceCount"), Summary.FaceCount);
+							Entry->SetStringField(TEXT("ExportViewFormat"), ToJson(Summary.ViewFormat));
+							Entry->SetStringField(TEXT("ReadStateBasis"), TEXT("OwnerPassSRVBinding"));
+							Entry->SetBoolField(TEXT("OwnerPassExecutionDependencyClaimed"), false);
+							Entry->SetBoolField(TEXT("SourceStateProvenAtScheduling"), FRDGBuilder::IsImmediateMode());
+							Entry->SetStringField(TEXT("TimingRisk"), FRDGBuilder::IsImmediateMode()
+								? TEXT("None")
+								: TEXT("OwnerPassNotExecutedAtCPUCollection;NativeResourceHasNoRDGExecutionDependency"));
+							Entry->SetBoolField(TEXT("RegistryMutation"), false);
+							Entry->SetBoolField(TEXT("FileVerified"), false);
+							Entry->SetStringField(TEXT("ReadbackStatusFile"), TEXT("Base/DumpReadbackStatus.json"));
+							Entry->SetBoolField(TEXT("CrossUniformBufferAliasObservable"), false);
+							Entry->SetBoolField(TEXT("ReusedScheduledReadback"), Summary.bReusedExistingReadback);
+							if (Summary.bReusedExistingReadback)
+							{
+								Entry->SetStringField(TEXT("FirstScheduledByPass"), Summary.FirstScheduledByPass);
+								Entry->SetStringField(TEXT("DumpStatus"), TEXT("ScheduledByEarlierPass"));
+							}
+							else
+							{
+								Entry->SetStringField(TEXT("DumpStatus"), bStream
+									? TEXT("ScheduledStreamedForReadback")
+									: TEXT("ScheduledForReadback"));
+							}
+						}
+						else
+						{
+							Entry->SetStringField(TEXT("DumpStatus"),
+								Summary.SkipReason ? Summary.SkipReason : TEXT("SkippedNativeTextureViewNotSchedulable"));
+							Entry->SetBoolField(TEXT("RegistryMutation"), false);
+							Entry->SetStringField(TEXT("ExportScope"), bWholeTexture ? TEXT("WholeNativeResource") : TEXT("ExactSRVView"));
+						}
+					}
+					else
+					{
+						Entry->SetStringField(TEXT("DumpStatus"), TEXT("SkippedRegisterExternalTextureFailed"));
+					}
+				}
+			}
+			else if (Resource.MemberType != UBMT_SAMPLER && !bBufferView)
+			{
+				// A buffer view is handled above; this is a null or an unsupported native view kind, not a texture that
+				// happened to be missing.
+				Entry->SetStringField(TEXT("DumpStatus"), bNullView ? TEXT("SkippedNullNativeView") : TEXT("SkippedUnsupportedNativeViewKind"));
+			}
+
+			BindingsJson->SetObjectField(ElementName, Entry);
+		}
+
+		if (BindingsJson->Values.Num() > 0)
+		{
+			TSharedPtr<FJsonObject> FileEntry = MakeShareable(new FJsonObject);
+			FileEntry->SetStringField(TEXT("Pass"), PtrToString(Pass));
+			FileEntry->SetStringField(TEXT("UniformBuffer"), PtrToString(UniformBuffer));
+			FileEntry->SetStringField(TEXT("LayoutName"), Layout.GetDebugName());
+			// The CPU side traversal runs during graph-build parameter setup, not necessarily after the owner pass
+			// executed. The GPU readback pass is inserted after the owner in the RDG queue, but no execution
+			// dependency on the owner's GPU completion is claimed for native resources.
+			FileEntry->SetStringField(TEXT("CPUCollectionTiming"), TEXT("GraphBuildParameterTraversal"));
+			FileEntry->SetStringField(TEXT("GPUReadbackOrdering"), TEXT("InsertedAfterOwnerInRDGQueue"));
+			FileEntry->SetStringField(TEXT("CollectionTiming"), TEXT("GraphBuildParameterTraversal"));
+			FileEntry->SetBoolField(TEXT("OwnerPassExecutionDependencyClaimed"), false);
+			FileEntry->SetBoolField(TEXT("SourceStateProvenAtScheduling"), FRDGBuilder::IsImmediateMode());
+			FileEntry->SetStringField(TEXT("TimingRisk"), FRDGBuilder::IsImmediateMode()
+				? TEXT("None")
+				: TEXT("OwnerPassNotExecutedAtCPUCollection;NativeResourceHasNoRDGExecutionDependency"));
+			FileEntry->SetStringField(TEXT("ReadbackCompletionFile"), TEXT("Base/DumpReadbackStatus.json"));
+			FileEntry->SetStringField(TEXT("ScheduledStatus"), TEXT("ScheduledForReadback"));
+			FileEntry->SetStringField(TEXT("DumpedStatusSource"), TEXT("Base/DumpReadbackStatus.json after file verification"));
+			FileEntry->SetStringField(TEXT("ReadOnlyBindingPolicy"), TEXT("NoTransitionPrivateStagingOutput"));
+			FileEntry->SetStringField(TEXT("MutableBindingPolicy"), TEXT("NoBytesWhenWritableAliasOrUAVNotObservable"));
+			FileEntry->SetObjectField(TEXT("Bindings"), BindingsJson);
+			DumpJsonToFile(FileEntry, FString(FRDGResourceDumpContext::kBaseDir) / TEXT("NativeUniformBufferBindings.json"), FILEWRITE_Append);
+		}
+	}
+
+	/** Schedules the no-transition read of an exact native buffer SRV byte range into a private staging texture. */
+	void AddDumpNativeBufferViewPass(
+		FRDGBuilder& GraphBuilder,
+		const FRDGPass* Pass,
+		FRHIBuffer* Buffer,
+		uint32 OffsetInBytes,
+		uint32 ByteSize,
+		const FString& DumpFilePath)
+	{
+		check(Buffer);
+		check((OffsetInBytes % 4) == 0);
+		check(ByteSize > 0 && (ByteSize % 4) == 0);
+
+		const uint32 MaxStagingByteSize = uint32(FMath::Max(1, GDumpMaxStagingSize.GetValueOnRenderThread())) * 1024U * 1024U;
+		const uint32 StagingResourceByteSize = FMath::Max(4U, FMath::Min(ByteSize, MaxStagingByteSize));
+
+		// A native pass has no render graph resource parameters because the source is a raw RHI buffer owned by
+		// the dumped pass. RDG validation still requires a parameterized AddPass for Compute, so bind the empty
+		// parameter struct instead of using the parameterless overload (which only accepts None).
+		FEmptyShaderParameters* PassParameters = GraphBuilder.AllocParameters<FEmptyShaderParameters>();
+
+		GraphBuilder.AddPass(
+			RDG_EVENT_NAME("RDG DumpNativeBufferView(%s -> %s)", *Buffer->GetName().ToString(), *DumpFilePath),
+			PassParameters,
+			ERDGPassFlags::Compute | ERDGPassFlags::NeverCull,
+			[this, DumpFilePath, Buffer, OffsetInBytes, ByteSize, StagingResourceByteSize](FRHICommandListImmediate& RHICmdList)
+		{
+			check(IsInRenderingThread());
+			// The buffer is in the readable state the owning pass established; the readback never transitions it.
+			this->DumpRawBufferViewReadback(RHICmdList, Buffer, OffsetInBytes, ByteSize, StagingResourceByteSize, DumpFilePath);
+			this->RecordReadbackCompletion(DumpFilePath, int64(ByteSize), TEXT("Buffer"));
+			this->ReleaseRHIResources(RHICmdList);
+			this->UpdatePassProgress();
+		});
+
+		ResourcesDumpPasses++;
+	}
+
+	/** Returns whether the pass binds Buffer through a writable UAV parameter, in any of the RDG buffer parameter forms. */
+	static bool IsBufferBoundAsWritableInPass(const FRDGPass* Pass, FRDGBuffer* Buffer)
+	{
+		bool bWritable = false;
+
+		Pass->GetParameters().Enumerate([&](FRDGParameter Parameter)
+		{
+			if (bWritable)
+			{
+				return;
+			}
+
+			switch (Parameter.GetType())
+			{
+			case UBMT_RDG_BUFFER_UAV:
+			{
+				if (FRDGBufferUAVRef UAV = Parameter.GetAsBufferUAV())
+				{
+					bWritable |= (UAV->Desc.Buffer == Buffer);
+				}
+			}
+			break;
+			case UBMT_RDG_BUFFER_ACCESS:
+			{
+				if (FRDGBufferAccess BufferAccess = Parameter.GetAsBufferAccess())
+				{
+					bWritable |= (BufferAccess.GetBuffer() == Buffer && IsWritableAccess(BufferAccess.GetAccess()));
+				}
+			}
+			break;
+			case UBMT_RDG_BUFFER_ACCESS_ARRAY:
+			{
+				for (FRDGBufferAccess BufferAccess : Parameter.GetAsBufferAccessArray())
+				{
+					if (BufferAccess.GetBuffer() == Buffer && IsWritableAccess(BufferAccess.GetAccess()))
+					{
+						bWritable = true;
+						break;
+					}
+				}
+			}
+			break;
+			default:
+				break;
+			}
+		});
+
+		return bWritable;
+	}
+
+	/**
+	 * Reads an exact byte range of a native buffer through a raw SRV without ever transitioning the buffer.
+	 *
+	 * The caller has already established that the source state is readable: either RDG locked a SkipTracking buffer in
+	 * external access mode and the dumped pass binds it read-only, or a referenced uniform buffer binds a native buffer
+	 * SRV whose owner pass requires the readable state. The bytes are copied into a private linear staging texture by a
+	 * compute shader, four source bytes per uint texel, and written verbatim. No pixel format conversion is applied and
+	 * no value is fabricated. OffsetInBytes is the exact view offset; ByteSize is the exact view size. Raw buffer views
+	 * require 16 byte aligned offsets, so the RHI view starts at the aligned address before the request and the shader
+	 * skips that prefix; the requested bytes are still the exact tail of the view.
+	 */
+	void DumpRawBufferViewReadback(
+		FRHICommandListImmediate& RHICmdList,
+		FRHIBuffer* Buffer,
+		uint32 OffsetInBytes,
+		uint32 ByteSize,
+		uint32 StagingResourceByteSize,
+		const FString& DumpFilePath)
+	{
+		check(Buffer);
+		check(IsInRenderingThread());
+		check((OffsetInBytes % 4) == 0);
+		check((ByteSize % 4) == 0);
+		check(StagingResourceByteSize > 0 && (StagingResourceByteSize % 4) == 0);
+
+		const uint32 GPUIndex = RHICmdList.GetGPUMask().GetLastIndex();
+
+		TUniquePtr<FArchive> Ar;
+		if (bEnableDiskWrite)
+		{
+			FString FullPath = GetDumpFullPath(DumpFilePath);
+			FFileWriteCtx WriteCtx(this, ETimingBucket::ResourceBinaryFileWrite, /* ByteSize = */ 0);
+			Ar = TUniquePtr<FArchive>(IFileManager::Get().CreateFileWriter(*FullPath, /* WriteFlags = */ 0));
+		}
+
+		for (uint32 Offset = 0; Offset < ByteSize; Offset += StagingResourceByteSize)
+		{
+			const uint32 CopyByteSize = FMath::Min(StagingResourceByteSize, ByteSize - Offset);
+			const uint32 CopyNumElements = CopyByteSize / 4;
+			const uint32 WidthElements = FMath::Max(1u, FMath::Min<uint32>(CopyNumElements, 2048u));
+			const uint32 Height = FMath::DivideAndRoundUp(CopyNumElements, WidthElements);
+			const FIntPoint StagingExtent = FIntPoint(int32(WidthElements), int32(Height));
+
+			// Raw buffer views require the view offset to be a multiple of 16 bytes (RHIResources.cpp:238).
+			// The requested sub-range is not necessarily 16 byte aligned (only the 4 byte element alignment
+			// is guaranteed), so the raw view starts at an aligned address before the request and the shader
+			// skips the prefix. The view still ends exactly at the end of the requested range, so it never
+			// reads past the bound SRV or the native buffer.
+			const uint32 RequestedOffset = OffsetInBytes + Offset;
+			const uint32 AlignedOffset = RequestedOffset & ~15u;
+			const uint32 PrefixBytes = RequestedOffset - AlignedOffset;
+			const uint32 RawByteSize = PrefixBytes + CopyByteSize;
+			const uint32 RawNumElements = RawByteSize / 4;
+			check((AlignedOffset % 16) == 0);
+			check((PrefixBytes % 4) == 0);
+			check((RawByteSize % 4) == 0);
+			check((uint64(AlignedOffset) + uint64(RawByteSize)) <= uint64(Buffer->GetDesc().Size));
+
+			FTextureRHIRef PreprocessTexture;
+			FTextureRHIRef StagingTexture;
+			FShaderResourceViewRHIRef SourceSRV;
+
+			{
+				FTimeBucketMeasure TimeBucketMeasure(this, ETimingBucket::RHIReadbackCommands);
+
+				const FRHITextureCreateDesc PreprocessDesc =
+					FRHITextureCreateDesc::Create2D(TEXT("DumpGPU.PreprocessBuffer"), StagingExtent, PF_R32_UINT)
+					.SetFlags(ETextureCreateFlags::UAV | ETextureCreateFlags::ShaderResource | ETextureCreateFlags::HideInVisualizeTexture);
+
+				CreateStagingTexture(RHICmdList, PreprocessDesc, /* out */ &PreprocessTexture);
+				RHICmdList.Transition(FRHITransitionInfo(PreprocessTexture, ERHIAccess::Unknown, ERHIAccess::UAVCompute));
+
+				FUnorderedAccessViewRHIRef StagingOutput = CreateUAVNoLifetimeExtension(RHICmdList, PreprocessTexture, /* MipLevel = */ 0);
+
+				// Raw (ByteAddressBuffer) view so that no pixel format conversion is applied to the source bytes.
+				// The view starts at the 16 byte aligned address before the requested range and covers the prefix,
+				// so the requested bytes are still the exact tail of the view.
+				SourceSRV = RHICmdList.CreateShaderResourceView(
+					Buffer,
+					FRHIViewDesc::CreateBufferSRV()
+						.SetType(FRHIViewDesc::EBufferType::Raw)
+						.SetOffsetInBytes(AlignedOffset)
+						.SetNumElements(RawNumElements));
+				SourceSRV->DisableLifetimeExtension();
+
+				FDumpBufferCS::FParameters ShaderParameters;
+				ShaderParameters.SourceBuffer = SourceSRV;
+				ShaderParameters.StagingOutput = StagingOutput;
+				ShaderParameters.NumElements = CopyNumElements;
+				ShaderParameters.WidthElements = WidthElements;
+				ShaderParameters.SourceByteOffset = PrefixBytes;
+
+				TShaderMapRef<FDumpBufferCS> ComputeShader(GetGlobalShaderMap(GMaxRHIShaderPlatform));
+				FComputeShaderUtils::Dispatch(
+					RHICmdList,
+					ComputeShader,
