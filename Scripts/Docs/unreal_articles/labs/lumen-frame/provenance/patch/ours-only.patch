+		bOutValuePreserving = false;
+
+		if (NativeFormat == PF_Unknown || NativeFormat >= PF_MAX || GPixelFormats[NativeFormat].BlockBytes == 0)
+		{
+			OutInterpretation = TEXT("Unknown");
+			OutCondition = TEXT("The native pixel format has no GPU format entry.");
+			return;
+		}
+
