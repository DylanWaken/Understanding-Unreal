      "quantity": "2-band SH radiance moments per probe and color channel, pre-exposed; named IrradianceSH in shader but NOT cosine-convolved",
      "units": "pre-exposed radiance moments (L*Y integrated)",
      "coordinateSpace": "probe atlas (physical atlas / probeSpacing); each texel = 4 SH coefficients",
      "storage": {
        "kind": "texture2d",
        "format": "PF_FloatRGBA",
        "strideBytes": 16
      },
      "actualFormat": "PF_FloatRGBA",
      "declaredFormat": "PF_FloatRGBA",
