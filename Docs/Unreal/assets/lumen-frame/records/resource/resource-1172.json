      "decodingStatus": "complete",
      "transforms": [
        {
          "name": "accumulateSH",
          "expression": "SH = (1/N) * Sum_rays AddSH(SHBasisFunction(dir), Radiance/PDF)",
          "requires": [
            "TraceRadianceAtlas",
            "PDF"
          ],
          "sourceRefs": [
            "part0.LRad_sh",
            "part0.LRad_shnorm",
            "part0.LRad_shstore"
          ]
        },
        {
          "name": "cosineTransfer",
          "expression": "TexelRadiance = max(0, DotSH(interpolated SH, CalcDiffuseTransferSH(n,1))); if WeightSum > 0: TexelRadiance /= WeightSum",
          "requires": [
            "ProbeSH atlases",
            "Normal",
            "WeightSum"
          ],
          "sourceRefs": [
            "part0.LRad_transfer",
            "part0.LRad_dot",
            "part0.LRad_weightsum",
            "part0.SH_transfer"
          ]
        }
      ],
      "mathTerms": [
        "SH_lm = (1/N) * sum L(w)*Y_lm(w)/PDF",
        "E(n) = sum_lm SH_lm * A_l*Y_lm(n), A_0=pi, A_1=2*pi/3 for Exponent=1",
        "After bilinear probe accumulation, TexelRadiance is divided by the accumulated WeightSum when WeightSum > 0 (LumenRadiosity.usf:543-546); WeightSum is a bilinear sample weight, not a stored SH coefficient."
      ],
      "producerSources": [
        "part0.LRad_sh",
        "part0.LRadCpp_shfmt"
      ],
      "consumerSources": [
        "part0.LRad_transfer",
        "part0.LRad_dot"
      ],
      "gaps": [
        "Shader local name IrradianceSH is misleading: the stored atlas contains radiance moments before the cosine transfer; transfer happens in LumenRadiosityIntegrateCS.",
        "Probe atlas addressing, probe spacing and temporal jitter (GetProbeJitter) are separate decode inputs.",
        "Only 2-band (4 coefficients) is stored; higher bands are not available."
      ],
