          "expression": "CardIndex = A & 0xFFFFFF; DesiredResLevel = A>>24; LocalPage = (B&0xFF, (B>>8)&0xFF)",
          "requires": [
            "Lumen.Feedback"
          ],
          "sourceRefs": [
