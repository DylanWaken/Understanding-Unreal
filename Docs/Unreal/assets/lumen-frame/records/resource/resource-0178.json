      "transforms": [
        {
          "name": "pack",
          "expression": "Word128 = (LightFunctionAtlasLightIndex & 0x1FFFFFFF) | (NeedsShadowMask ? 1<<31 : 0) | (!CanUseBatchedShadows ? 1<<30 : 0) | (bHasShadows ? 1<<29 : 0)",
          "requires": [
