          ]
        },
        {
          "name": "decode",
          "expression": "WorldPosition = DFHackToFloat(MakeDFVector3(High,Low)); DiffuseScale/SpecularScale = UnpackFloat2FromUInt(word60); bHasShadowMask = word128>>31; bIsStandalone = bit30; bHasShadows = bit29",
          "requires": [
            "Lumen.DirectLighting.Lights"
