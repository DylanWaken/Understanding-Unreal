      "quantity": "per-probe directional (L1) SH coefficients of the probe radiance, luminance-normalized to 6 half4 texels per probe",
      "units": "optionally quantized directional SH coefficients; when SH_QUANTIZE_DIRECTIONAL_COEFFICIENTS each texel is code = coef/ambient*0.5+0.5",
      "coordinateSpace": "6 texels per probe: 2 texels x 3 channels, X-strided by ScreenProbeAtlasViewSize.x",
      "storage": {
        "kind": "texture2d",
        "format": "PF_FloatRGBA (RGBA16F)",
        "strideBytes": 8,
        "extent": "(ScreenProbeAtlasBufferSize.X*6, ScreenProbeAtlasBufferSize.Y) (captured 480x84)",
