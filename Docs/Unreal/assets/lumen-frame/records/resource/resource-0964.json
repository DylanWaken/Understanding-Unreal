      "decodingStatus": "complete",
      "transforms": [
        {
          "name": "compact",
          "expression": "For each non-empty hash bucket: WriteOffset = InterlockedAdd(Buffer[0].x,1)+1; if WriteOffset < Size: Buffer[WriteOffset] = Feedback[ElementIndex]; Buffer[WriteOffset].y |= ElementCount<<16",
          "requires": [
            "Lumen.CompactedFeedback",
            "Lumen.HashTableElementCounts",
            "Lumen.HashTableElementIndices"
          ],
          "sourceRefs": [
            "part1.cards_cfb_header",
            "part1.cards_cfb_count",
            "part1.cards_cfb_skip"
          ]
        },
        {
          "name": "readback",
          "expression": "Num = Data[0]; for i in [0,Num): A = Data[(i+1)*2+0]; B = Data[(i+1)*2+1]",
          "requires": [
            "Lumen.CompactedFeedback"
          ],
          "sourceRefs": [
            "part1.cards_cfb_read",
            "part1.cards_cfb_readb"
          ]
        }
      ],
      "mathTerms": [
        "capacity = RoundUpToPowerOfTwo(clamp(r.LumenScene.SurfaceCache.Feedback.UniqueElements,1,16384)) = 1024 in this capture (8192 B)",
        "element 0 is a header; valid requests are [1, 1+min(count,size-1))",
        "count in .y is 16 bits and is not clamped by the shader; the readback side clamps DesiredResLevel and page coords"
      ],
      "producerSources": [
        "part1.cards_cfb_header",
        "part1.cards_cfb_count",
        "part1.cards_cfb_alloc"
      ],
      "consumerSources": [
        "part1.cards_cfb_read",
        "part1.cards_cfb_readb"
      ],
      "gaps": [
        "The hit count is a count of raw feedback writes for the bucket, including duplicates and out-of-screen jitter writes; it is not a filtered visibility count.",
        "At most one element is stored per hash bucket; hash collisions with different keys increment the same bucket (see HashTable keys gap), so the count is an upper bound for the first element's request.",
        "The compacted array is ordered by hash-table bucket index, not by screen position or priority."
      ],
