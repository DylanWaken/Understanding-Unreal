          ],
          "sourceRefs": [
            "part3.visibility.df.obj.toVol"
          ]
        },
        {
          "name": "distanceToWorld",
          "expression": "DistanceToNearestSurface = SDF(ClampedVolumePos)*VolumeScale + max(0, DistanceToBoxVolume*VolumeToWorldScale)",
          "requires": [
            "DistanceFields.DFObjectData"
          ],
          "sourceRefs": [
            "part3.visibility.df.obj.volscale"
          ]
        }
