      "transforms": [
        {
          "name": "volumeToWorld",
          "expression": "TranslatedWorldPos = VolumePos*VolumeToRelativeWorld.3x3 + M[3].xyz + PositionHigh + PreViewTranslation",
          "requires": [
            "DistanceFields.DFObjectData"
          ],
          "sourceRefs": [
            "part3.visibility.df.obj.toWorld"
