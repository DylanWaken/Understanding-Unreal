          "resourceNameRegex": "^Lumen\\.ScreenProbeGather\\.ScreenProbeWorldSpeed$",
          "passNameRegex": null
        }
      ],
      "quantity": "per-probe screen-space motion speed (|world position - reprojected previous world position|) with two material flags packed into a half",
      "units": "16-bit half bit pattern: bits[1:14] = speed in cm/frame; bit15 = bTwoSidedFoliage; bit0 = bHair",
      "coordinateSpace": "translated world displacement per frame (cm); indexed by probe atlas texel",
      "storage": {
        "kind": "texture2d",
        "format": "PF_R16_UINT",
        "strideBytes": 2,
        "extent": "ScreenProbeAtlasBufferSize (captured 80x84)",
        "mips": 1,
        "flags": [
          "ShaderResource",
          "UAV"
        ],
        "captureObserved": [
          {
            "descriptor": "FRDGTextureDesc",
            "type": "Texture2D",
            "format": "PF_R16_UINT",
            "extentX": 80,
            "extentY": 84,
            "depth": 1,
            "arraySize": 1,
            "numMips": 1,
            "byteSize": 13440
          }
        ]
      },
      "actualFormat": "PF_R16_UINT",
      "declaredFormat": "PF_R16_UINT",
      "declaredFormatText": "PF_R16_UINT",
      "formatProof": "explicit-pf",
      "gateFormat": "PF_R16_UINT",
      "formatAlternatives": [],
      "dumpFormat": "PF_R16_UINT",
      "payloadFormat": "PF_R16_UINT",
      "formatMatch": true,
      "dumpFormatMatchDeclared": true,
      "payloadFormatMatch": true,
      "activeFormatVariant": null,
      "formatVariantFields": [],
      "formatGatedFields": [],
      "primaryFieldsExtractable": true,
      "extractionEligible": true,
      "extractionEligibleReason": null,
      "decodingStatus": "complete",
      "transforms": [
        {
          "name": "encode",
          "expression": "code = (f32tof16(speed) & 0x7FFE) | (bTwoSidedFoliage ? 0x8000 : 0) | (bHair ? 1 : 0)",
          "requires": [
            "ProbeSpeed",
            "bTwoSidedFoliage",
            "bHair"
          ],
          "sourceRefs": [
            "part2.spg.ush.speed.encode",
            "part2.spg.ush.speed.bits"
          ]
        },
        {
          "name": "decode",
          "expression": "speed = f16tof32(code & 0x7FFE); flags from bits 15 and 0",
          "requires": [
            "ScreenProbeWorldSpeed"
          ],
          "sourceRefs": [
            "part2.spg.ush.speed.decodeval"
          ]
        }
      ],
      "mathTerms": [
        "The speed is a per-frame displacement, so it is resolution-independent but frame-rate dependent; do not interpret it as cm/s without the frame delta.",
        "The sign bit of the half is reused for bTwoSidedFoliage; the speed itself is non-negative by construction (length of a vector)."
      ],
      "producerSources": [
        "part2.spg.cpp.speed"
      ],
      "consumerSources": [
        "part2.spg.usf.speed",
        "part2.spg.ush.speed.decodeval"
      ],
      "gaps": [
        "f32tof16 of a large displacement saturates at 65504; bits 14 and 15 of the exponent are shared with the flag encoding, so only the low 14 bits of the half pattern hold the magnitude."
      ],
      "fields": [
        {
          "name": "Speed",
          "type": "float16",
          "decode": "f16tof32(code & 0x7FFE); |current translated world position - previous translated world position|",
          "units": "cm/frame",
          "sourceRefs": [
            "part2.spg.ush.speed.bits",
            "part2.spg.ush.speed.decodeval"
          ],
          "byteOffset": 0,
          "bitOffset": 1,
          "bitWidth": 14
        },
        {
          "name": "bTwoSidedFoliage",
          "type": "uint1",
          "decode": "(code & 0x8000) != 0",
