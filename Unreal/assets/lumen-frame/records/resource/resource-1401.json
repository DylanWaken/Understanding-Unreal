      "transforms": [
        {
          "name": "pack",
          "expression": "nibble = round(ShadowFactor*15) & 15 placed at bit (i%8)*4 in dword i/8",
          "requires": [
            "MaskBits"
          ],
          "sourceRefs": [
            "part3.visibility.vsm.s.maskpack"
          ]
        },
        {
          "name": "unpack",
          "expression": "ShadowFactor = float((Mask[i/8] >> ((i%8)*4)) & 15) / 15.0",
          "requires": [
            "MaskBits"
          ],
          "sourceRefs": [
            "part3.visibility.vsm.s.maskunpack"
          ]
        },
        {
          "name": "ditherUnpack",
          "expression": "if 0<f<1: f = saturate(f + (Dither-0.5)/16)",
          "requires": [
            "MaskBits"
          ],
          "sourceRefs": [
            "part3.visibility.vsm.s.maskunpack"
          ]
        }
      ],
      "mathTerms": [
        "4 bits per light; 8 lights per dword; max 32 lights across uint4 (LightGridCommon.ush:240-269).",
        "OutShadowMaskBits is written as uint4 (VirtualShadowMapProjection.usf:259,1040) but the texture format truncates to the selected dword count.",
        "Dither variant adds (Dither-0.5)/16 to fractional values (LightGridCommon.ush:272-280)."
      ],
      "producerSources": [
