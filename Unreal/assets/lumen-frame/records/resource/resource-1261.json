      "gaps": [
        "Bit0 (two-sided) overlaps the low mantissa bit, so hit distance loses that bit of precision.",
        "Backface semantics: bBackface = !bFrontface && !bTwoSided (LumenRadianceCacheInterpolation.ush:289)."
      ],
      "fields": [
