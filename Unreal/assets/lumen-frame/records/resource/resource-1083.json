      "quantity": "per-card GPU record: LWC world-space OBB origin, world->local rotation, mesh-cards axes/origin/extent, low- and high-res page-table spans, visibility flags and average texel size",
      "units": "floats in world units (cm) for origin/extent/texel size; integer indices, res-level bias bytes, 4-bit direction/channel fields and 1-bit flags",
      "coordinateSpace": "world space for Origin/rotation (double-float split); mesh-cards local space for MeshCardsOrigin/Extent; card page-table index space for offsets",
      "storage": {
        "kind": "structured-buffer",
        "format": "float4[7] per card (112 B/card); RDG buffer element is 16 B because ResizeStructuredBufferIfNeeded allocates 16-B elements",
        "strideBytes": 112
      },
      "actualFormat": null,
      "declaredFormat": null,
      "declaredFormatText": "float4[7] per card (112 B/card); RDG buffer element is 16 B because ResizeStructuredBufferIfNeeded allocates 16-B elements",
      "formatProof": "descriptive-element-layout",
      "gateFormat": null,
      "formatAlternatives": [],
      "dumpFormat": null,
      "payloadFormat": null,
