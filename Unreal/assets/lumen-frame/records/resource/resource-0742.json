      "transforms": [
        {
          "name": "bucketIndex",
          "expression": "LastTraced==0 ? 0 : 15 - clamp(log2(max(LastUsed-LastTraced,1)/(ClipmapIndex+1)),0,14)",
          "requires": [
            "ProbeLastTracedFrame",
            "ProbeLastUsedFrame",
            "ClipmapIndex"
          ],
          "sourceRefs": [
            "part2.rc.upd.bucket",
            "part2.rc.upd.bucket.never",
            "part2.rc.upd.bucket.log"
          ]
        },
        {
          "name": "cost",
          "expression": "cost = 1 if distanceSq >= DownsampleDistanceFromCameraSq; 16 if distanceSq < SupersampleDistanceFromCameraSq; else 4",
          "requires": [
            "DownsampleDistanceFromCameraSq",
            "SupersampleDistanceFromCameraSq"
          ],
          "sourceRefs": [
            "part2.rc.upd.cost"
          ]
        }
      ],
      "mathTerms": [
        "The bucket sum is in cost units so a 16x supersampled probe weighs 16x a downsampled one; do not interpret a bucket value as probe count.",
        "Bucket 0 also receives PROBE_TRACE_COST_DOWNSAMPLED into MinNewProbeTraceCost, but PriorityHistogram[b] adds the full cost."
      ],
