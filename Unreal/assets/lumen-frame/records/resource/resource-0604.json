      "transforms": [
        {
          "name": "unpackMeshCards",
          "expression": "BaseOffset = MeshCardsId*6; Origin = DFHackToFloat(MakeDFVector3(V0.xyz, float3(V1.w,V2.w,V3.w))); CardMask = OR over axes CardLookup[2*axis + sign]",
          "requires": [
            "Lumen.MeshCards"
          ],
          "sourceRefs": [
            "part1.cards_ush_mc_get",
            "part1.cards_mc_cons_lookup"
          ]
        },
        {
          "name": "unpackFlags",
          "expression": "NumCards = V4.y & 0xFFFF; bHeightfield = (V4.y & 0x10000)!=0; bMostlyTwoSided = (V4.y & 0x20000)!=0",
          "requires": [
            "Lumen.MeshCards"
          ],
          "sourceRefs": [
            "part1.cards_ush_mc_count",
            "part1.cards_ush_mc_flags"
          ]
        }
      ],
      "mathTerms": [
        "6 float4 per mesh-cards record = 96 B semantic stride; capture capacity 64 float4 = 1024 B means at most floor(64/6)=10 complete records (NumMeshCards in [6,10] because RoundUpToPowerOfTwo(6*N)=64)",
        "CardLookup bits index local card index: CardIndex = CardOffset + bitIndex",
        "V4.y bits 18-31 are unused (only bit16 bHeightfield and bit17 bMostlyTwoSided are defined)"
      ],
      "producerSources": [
        "part1.cards_mc_fill",
        "part1.cards_mc_alloc"
