        },
        {
          "name": "sample",
          "expression": "ProbeUV = InverseEquiAreaSphericalMapping(WorldSpaceDirection); Texel = Base + ProbeUV*RadianceProbeResolution + border; Radiance = Atlas.SampleLevel(...) * RadianceCacheOneOverCachedLightingPreExposure",
          "requires": [
            "WorldSpaceDirection",
            "ProbeIndex"
          ],
          "sourceRefs": [
            "part2.rc.i.probeuv",
            "part2.rc.i.atlasbase",
            "part2.rc.i.depreexp",
            "part2.mc.equiinv"
          ]
        }
      ],
      "mathTerms": [
        "Atlas X size = ProbeAtlasResolutionInProbes.X * RadianceProbeResolution; captured 1024x1024 and 4096x4096 variants correspond to different caches/resolutions.",
