      "transforms": [
        {
          "name": "probeBlockBase",
          "expression": "Base = RadianceProbeResolution * uint2(ProbeIndex & ProbeAtlasResolutionModuloMask, ProbeIndex >> ProbeAtlasResolutionDivideShift)",
          "requires": [
            "ProbeIndex",
            "RadianceProbeResolution"
          ],
          "sourceRefs": [
            "part2.rc.atlas.base"
          ]
        },
        {
          "name": "texelDirection",
          "expression": "ProbeUV = (TraceTexelCoord + 0.5) / TraceResolution; Direction = EquiAreaSphericalMapping(ProbeUV); ConeHalfAngle = acos(1 - 1/TraceResolution^2)",
          "requires": [
