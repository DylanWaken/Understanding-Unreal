      "actualFormat": "PF_B8G8R8A8",
      "declaredFormat": "PF_B8G8R8A8",
      "declaredFormatText": "PF_B8G8R8A8",
      "formatProof": "explicit-pf",
      "gateFormat": "PF_B8G8R8A8",
      "formatAlternatives": [
        "PF_FloatRGBA (high-precision)"
      ],
      "dumpFormat": "PF_B8G8R8A8",
