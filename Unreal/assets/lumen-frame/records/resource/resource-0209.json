          "resourceNameRegex": "^GBufferC(?:_[0-9]+)?$",
          "passNameRegex": "^BasePass"
        }
      ],
      "quantity": "base color (RGB, sRGB-encoded target) plus one of diffuse-sample occlusion / indirect irradiance / AO in A",
      "units": "linear base color after sRGB decode; alpha quantity depends on permutation",
      "coordinateSpace": "material base color",
      "storage": {
        "kind": "texture2d",
        "format": "PF_B8G8R8A8",
        "strideBytes": 4,
        "formatAlternatives": [
