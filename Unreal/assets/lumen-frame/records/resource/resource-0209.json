          ],
          "bitOffset": 0,
          "bitWidth": 8
        },
        {
          "name": "Alpha",
          "type": "unorm8",
          "decode": "variant A (default r.GBufferDiffuseSampleOcclusion=0, ALLOW_STATIC_LIGHTING): indirect irradiance = OneOverPreExposure*(exp2(16*A-8)-2^-8), where A includes +QuantizationBias/255; variant B: AO or diffuse-sample occlusion in [0,1].",
          "units": "mixed",
