      ],
      "quantity": "per-screen-tile count of adaptive probes whose list entry lives in that tile",
      "units": "adaptive probe count (uint32) per screen tile",
      "coordinateSpace": "screen-tile grid = ScreenProbeViewportBufferSize (ceil(SceneExtent/downsample), captured 80x56)",
      "storage": {
        "kind": "texture2d",
