      "decodingStatus": "complete",
      "transforms": [
        {
          "name": "increment",
          "expression": "InterlockedAdd(RWScreenTileAdaptiveProbeHeader[ScreenTileCoord], 1, TileProbeIndex)",
          "requires": [
            "ScreenTileCoord"
          ],
          "sourceRefs": [
            "part2.spg.usf.header.write"
          ]
        },
        {
          "name": "listIndex",
          "expression": "AdaptiveProbeCoord = (TileProbeIndex % DownsampleFactor, TileProbeIndex / DownsampleFactor) * ScreenProbeViewSize + ScreenTileCoord",
          "requires": [
            "TileProbeIndex",
            "ScreenProbeDownsampleFactor",
            "ScreenProbeViewSize"
          ],
          "sourceRefs": [
            "part2.spg.ush.adaptivecoord.formula",
            "part2.spg.usf.indices.write"
          ]
        }
      ],
      "mathTerms": [
        "The header is cleared to 0 with AddClearUAVPass before spawning; TexCreate_AtomicCompatible is required for the interlocked add.",
        "The tile coordinate is GetScreenTileCoord(AdaptiveSampleScreenCoord), i.e. jitter-removed, viewport-relative."
      ],
      "producerSources": [
        "part2.spg.cpp.header.create",
        "part2.spg.usf.header.write"
      ],
      "consumerSources": [
        "part2.spg.ush.adaptivecoord"
      ],
      "gaps": [
        "The count indexes a fixed downsampleFactor x downsampleFactor slot grid per tile; if more probes than downsampleFactor^2 are spawned for one tile, TileProbeIndex exceeds the slot range but the header still increments (the index formula then aliases). This is bounded by construction only when the tile's probe samples are unique."
      ],
      "fields": [
